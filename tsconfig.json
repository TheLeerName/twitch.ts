{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"lib": ["ES2020", "DOM"],
		"moduleResolution": "nodenext",
		"typeRoots": [
			"node_modules/@types"
		],
		"types": ["node"],
		"rootDir": "./src",
		"outDir": "./dist",
		"emitDeclarationOnly": false,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.js",
	],
	"exclude": [
		"node_modules",
		"src/old",
		"src/useraccessclient.ts",
		"src/utils.ts",
	]
}